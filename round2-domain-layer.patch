index 0000000..4bf2ffe
--- /dev/null
+++ b/prototype/src/domain/assessRisk.ts
@@ -0,0 +1,269 @@
+import type {
+  ResponsibleParty,
+  RiskAssessmentResult,
+  RiskCase,
+  RiskCategory,
+  RiskItem,
+  RiskRow,
+  RiskSeverity,
+} from "../contracts/riskAssessment";
+
+export type {
+  DocumentType,
+  ImsStatus,
+  ItcAvailability,
+  ResponsibleParty,
+  RiskAssessmentResult,
+  RiskCase,
+  RiskCategory,
+  RiskEvidenceFields,
+  RiskItem,
+  RiskRow,
+  RiskSeverity,
+} from "../contracts/riskAssessment";
+
+interface RiskRule {
+  severity: RiskSeverity;
+  whyItMatters: string;
+  whoCausedIt: ResponsibleParty;
+  whatToDo: string;
+  atRisk: boolean;
+}
+
+/**
+ * These strings are the only explanation the model is permitted to paraphrase.
+ * Keeping them here, next to the rule that fires them, is what makes the
+ * generated language checkable against the deterministic verdict.
+ */
+const RISK_RULES: Record<RiskCategory, RiskRule> = {
+  credit_note_reducing_itc: {
+    severity: "act_now",
+    whyItMatters:
+      "Your supplier has sent a note that reduces your credit. Nobody has responded to it. If you do nothing, it is treated as accepted and this credit is gone.",
+    whoCausedIt: "supplier",
+    whatToDo:
+      "Open the invoice screen and accept or reject this note before the date shown.",
+    atRisk: true,
+  },
+  supplier_not_filed: {
+    severity: "act_now",
+    whyItMatters:
+      "Your books show this purchase, but your supplier has not filed it. It has not reached your credit statement, and there is no button you can press to fix it yourself.",
+    whoCausedIt: "supplier",
+    whatToDo: "Contact this supplier and ask them to file this bill.",
+    atRisk: true,
+  },
+  wrongly_rejected: {
+    severity: "act_now",
+    whyItMatters:
+      "This bill was rejected on the portal, but your own books say you bought it. A rejection you did not intend costs you the credit.",
+    whoCausedIt: "you",
+    whatToDo:
+      "Check whether this rejection was a mistake, and correct it before the date shown.",
+    atRisk: true,
+  },
+  itc_not_available: {
+    severity: "check",
+    whyItMatters:
+      "The government has marked this credit as not available, and given a reason.",
+    whoCausedIt: "rules",
+    whatToDo:
+      "Read the reason and confirm with a professional whether it can be corrected.",
+    atRisk: true,
+  },
+  deemed_accept_harmless: {
+    severity: "info",
+    // Deliberately does not say "no action needed". We only know this bill
+    // matches the business's own records. We have not verified those records,
+    // and accepting a bill still has consequences if they are wrong.
+    whyItMatters:
+      "Nobody has responded to this bill, so it will be accepted automatically. Your own records agree with it, so this looks correct. We have not checked it beyond that.",
+    whoCausedIt: "nobody",
+    whatToDo:
+      "Nothing is at risk here based on your own records. Check it yourself if those records may be wrong.",
+    atRisk: false,
+  },
+  no_action_needed: {
+    severity: "ok",
+    whyItMatters:
+      "This bill matches your own records and has already been accepted.",
+    whoCausedIt: "nobody",
+    whatToDo: "Nothing to do here.",
+    atRisk: false,
+  },
+};
+
+function assertDemoId(value: string, field: string): void {
+  if (!value.startsWith("DEMO-")) {
+    throw new Error(`${field} must begin with DEMO-. Received: ${value}`);
+  }
+}
+
+function assertIsoDate(value: string, field: string): void {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    throw new Error(`${field} must be a valid ISO date (YYYY-MM-DD).`);
+  }
+  const [year, month, day] = value.split("-").map(Number);
+  const parsed = new Date(Date.UTC(year, month - 1, day));
+  if (
+    parsed.getUTCFullYear() !== year ||
+    parsed.getUTCMonth() !== month - 1 ||
+    parsed.getUTCDate() !== day
+  ) {
+    throw new Error(`${field} must be a valid ISO date (YYYY-MM-DD).`);
+  }
+}
+
+function assertPositiveInteger(value: number, field: string): void {
+  if (!Number.isSafeInteger(value) || value <= 0) {
+    throw new Error(`${field} must be a positive integer number of rupees.`);
+  }
+}
+
+function validateRiskCase(riskCase: RiskCase): void {
+  assertDemoId(riskCase.id, "risk case id");
+  if (!/^(\d{4})-(0[1-9]|1[0-2])$/.test(riskCase.period)) {
+    throw new Error("risk case period must use YYYY-MM with a valid month.");
+  }
+  assertIsoDate(riskCase.statementDate, "statement date");
+  assertIsoDate(riskCase.actionDeadline, "action deadline");
+  assertIsoDate(riskCase.annualCutoff, "annual cutoff");
+  if (riskCase.actionDeadline < riskCase.statementDate) {
+    throw new Error("action deadline must not be before the statement date.");
+  }
+  if (riskCase.rows.length === 0) {
+    throw new Error("risk case must contain at least one row.");
+  }
+
+  const seen = new Set<string>();
+  for (const row of riskCase.rows) {
+    assertDemoId(row.id, "risk row id");
+    if (seen.has(row.id)) {
+      throw new Error(`Duplicate risk row ID: ${row.id}.`);
+    }
+    seen.add(row.id);
+    assertDemoId(row.demoSupplierId, `supplier id ${row.id}`);
+    assertDemoId(row.invoiceNo, `invoice number ${row.id}`);
+    assertIsoDate(row.invoiceDate, `invoice date ${row.id}`);
+    assertPositiveInteger(row.taxAmount, `tax amount ${row.id}`);
+    if (row.supplierFiledDate !== null) {
+      assertIsoDate(row.supplierFiledDate, `supplier filed date ${row.id}`);
+    }
+    // A row that never reached the statement cannot carry a statement status.
+    if (row.supplierFiledDate === null && row.imsStatus !== null) {
+      throw new Error(
+        `${row.id} has no supplier filing date, so imsStatus must be null.`,
+      );
+    }
+  }
+}
+
+/**
+ * Classification order is load-bearing. The first matching rule wins, and the
+ * rules are ordered so that the loss which happens with no further human
+ * involvement is caught before anything else.
+ */
+export function classifyRiskRow(row: RiskRow): RiskCategory {
+  // 1. A credit note nobody has acted on. Silence destroys the credit.
+  if (row.docType === "credit_note" && row.imsStatus === "N") {
+    return "credit_note_reducing_itc";
+  }
+  // 2. In our books, but the supplier never filed. No unilateral remedy exists.
+  if (row.inPurchaseRegister && row.supplierFiledDate === null) {
+    return "supplier_not_filed";
+  }
+  // 3. The statement explicitly marks the credit unavailable, with a reason.
+  if (row.itcAvailable === "N") {
+    return "itc_not_available";
+  }
+  // 4. Rejected on the portal, but our own books say we bought it.
+  if (row.imsStatus === "R" && row.inPurchaseRegister) {
+    return "wrongly_rejected";
+  }
+  // 5. No action taken, but the bill agrees with our books, so acceptance is fine.
+  //    This branch exists so the tool does not cry wolf on every unactioned row.
+  if (
+    row.docType === "invoice" &&
+    row.imsStatus === "N" &&
+    row.inPurchaseRegister
+  ) {
+    return "deemed_accept_harmless";
+  }
+  return "no_action_needed";
+}
+
+function daysBetween(fromIso: string, toIso: string): number {
+  const ms =
+    Date.parse(`${toIso}T00:00:00Z`) - Date.parse(`${fromIso}T00:00:00Z`);
+  return Math.round(ms / 86_400_000);
+}
+
+export function assessRisk(
+  riskCase: RiskCase,
+  todayIso?: string,
+): RiskAssessmentResult {
+  validateRiskCase(riskCase);
+  const today = todayIso ?? riskCase.statementDate;
+  assertIsoDate(today, "today");
+
+  const items: RiskItem[] = riskCase.rows.map((row) => {
+    const category = classifyRiskRow(row);
+    const rule = RISK_RULES[category];
+    return {
+      rowId: row.id,
+      supplierName: row.supplierName,
+      invoiceNo: row.invoiceNo,
+      docType: row.docType,
+      category,
+      severity: rule.severity,
+      amountAtRisk: rule.atRisk ? row.taxAmount : 0,
+      whyItMatters: rule.whyItMatters,
+      whoCausedIt: rule.whoCausedIt,
+      whatToDo: rule.whatToDo,
+      evidenceFields: {
+        imsStatus: row.imsStatus,
+        itcAvailable: row.itcAvailable,
+        unavailableReason: row.unavailableReason,
+        supplierFiledDate: row.supplierFiledDate,
+        inPurchaseRegister: row.inPurchaseRegister,
+      },
+    };
+  });
+
+  const totalAmountAtRisk = items.reduce(
+    (total, item) => total + item.amountAtRisk,
+    0,
+  );
+  const amountLostIfNothingDone = items
+    .filter((item) => item.category === "credit_note_reducing_itc")
+    .reduce((total, item) => total + item.amountAtRisk, 0);
+
+  return {
+    caseId: riskCase.id,
+    period: riskCase.period,
+    statementDate: riskCase.statementDate,
+    actionDeadline: riskCase.actionDeadline,
+    annualCutoff: riskCase.annualCutoff,
+    daysRemaining: daysBetween(today, riskCase.actionDeadline),
+    totalAmountAtRisk,
+    amountLostIfNothingDone,
+    items,
+  };
+}
+
+const SEVERITY_ORDER: Record<RiskSeverity, number> = {
+  act_now: 0,
+  check: 1,
+  info: 2,
+  ok: 3,
+};
+
+/** Display helper: the thing that disappears first appears first. */
+export function sortItemsForDisplay(items: RiskItem[]): RiskItem[] {
+  return [...items].sort((a, b) => {
+    const bySeverity =
+      SEVERITY_ORDER[a.severity] - SEVERITY_ORDER[b.severity];
+    if (bySeverity !== 0) return bySeverity;
+    return b.amountAtRisk - a.amountAtRisk;
+  });
+}
diff --git a/prototype/src/services/answerValidator.ts b/prototype/src/services/answerValidator.ts
new file mode 100644
index 0000000..91e2200
--- /dev/null
+++ b/prototype/src/services/answerValidator.ts
@@ -0,0 +1,226 @@
+import type { RiskAssessmentResult } from "../contracts/riskAssessment";
+
+/**
+ * Validation for the citizen question-and-answer path.
+ *
+ * The model is allowed to do exactly one thing here: understand a question
+ * asked in ordinary words, in Hindi, English or a mix, and point at findings
+ * the engine has already decided. It is not allowed to introduce a number.
+ *
+ * The money guard below is the load-bearing part. Every money-scale figure in
+ * the model's answer must already exist in the deterministic result, so an
+ * invented rupee amount cannot reach the citizen even if the model produces
+ * one. This is checked, not trusted.
+ */
+
+const MAX_ANSWER_LENGTH = 600;
+const MAX_QUESTION_LENGTH = 300;
+
+export interface ValidatedAnswer {
+  answer: string;
+  citedRowIds: string[];
+  answerable: boolean;
+}
+
+export class AnswerValidationError extends Error {}
+
+function fail(reason: string): never {
+  throw new AnswerValidationError(reason);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Devanagari digits map to ASCII so a Hindi answer is checked as strictly. */
+function normalizeDigits(text: string): string {
+  return text.replace(/[०-९]/g, (digit) =>
+    String(digit.charCodeAt(0) - 0x0966),
+  );
+}
+
+/**
+ * Pulls every numeric token out of the text, tolerating Indian digit grouping
+ * (1,50,000) and decimals. Returns whole-number values.
+ */
+export function extractNumbers(text: string): number[] {
+  const normalized = normalizeDigits(text);
+  const matches = normalized.match(/\d[\d,]*(?:\.\d+)?/g) ?? [];
+  return matches
+    .map((token) => Number(token.replace(/,/g, "")))
+    .filter((value) => Number.isFinite(value));
+}
+
+/** Money figures the model may state, because the engine produced them. */
+export function allowedMoneyFigures(result: RiskAssessmentResult): Set<number> {
+  const allowed = new Set<number>();
+  allowed.add(result.totalAmountAtRisk);
+  allowed.add(result.amountLostIfNothingDone);
+  for (const item of result.items) {
+    if (item.amountAtRisk > 0) allowed.add(item.amountAtRisk);
+  }
+  return allowed;
+}
+
+function dateParts(iso: string): number[] {
+  const [year, month, day] = iso.split("-").map(Number);
+  return [year, month, day];
+}
+
+/**
+ * EVERY number the model is permitted to state, of any size.
+ *
+ * An earlier version of this guard only checked figures of 1,000 or more, on
+ * the assumption that small numbers were always dates or counts. That left a
+ * real hole: a wrong "800 rupaye" would have passed unchallenged. There is no
+ * safe threshold, so there is no threshold. Any number the engine did not
+ * produce is rejected, whatever its size.
+ */
+export function allowedNumbers(result: RiskAssessmentResult): Set<number> {
+  const allowed = allowedMoneyFigures(result);
+
+  // Time references the engine itself computed or holds.
+  allowed.add(result.daysRemaining);
+  for (const iso of [
+    result.statementDate,
+    result.actionDeadline,
+    result.annualCutoff,
+  ]) {
+    for (const part of dateParts(iso)) allowed.add(part);
+  }
+
+  // Counts the model may legitimately use, e.g. "2 bills need your attention".
+  for (let count = 0; count <= result.items.length; count += 1) {
+    allowed.add(count);
+  }
+
+  return allowed;
+}
+
+export function assertQuestionAcceptable(question: unknown): string {
+  if (typeof question !== "string") fail("Question must be text.");
+  const trimmed = question.trim();
+  if (trimmed.length === 0) fail("Question must not be empty.");
+  if (trimmed.length > MAX_QUESTION_LENGTH) {
+    fail(`Question must be ${MAX_QUESTION_LENGTH} characters or fewer.`);
+  }
+  return trimmed;
+}
+
+export function validateModelAnswer(
+  payload: unknown,
+  result: RiskAssessmentResult,
+): ValidatedAnswer {
+  if (!isRecord(payload)) fail("Model payload must be an object.");
+
+  const { answer, citedRowIds, answerable } = payload;
+
+  if (typeof answerable !== "boolean") {
+    fail("Model must state whether the question is answerable.");
+  }
+  if (typeof answer !== "string" || answer.trim().length === 0) {
+    fail("Model answer must be non-empty text.");
+  }
+  if (answer.length > MAX_ANSWER_LENGTH) {
+    fail(`Model answer must be ${MAX_ANSWER_LENGTH} characters or fewer.`);
+  }
+  if (
+    !Array.isArray(citedRowIds) ||
+    citedRowIds.some((id) => typeof id !== "string")
+  ) {
+    fail("Model must return citedRowIds as a list of strings.");
+  }
+
+  // Widened to string: the model returns untrusted text, so it must be checked
+  // against the known IDs rather than assumed to carry the DemoId shape.
+  const knownRowIds = new Set<string>(result.items.map((item) => item.rowId));
+  const cited = citedRowIds as string[];
+
+  for (const rowId of cited) {
+    if (!knownRowIds.has(rowId)) {
+      fail(`Model cited an unknown row: ${rowId}.`);
+    }
+  }
+  if (new Set(cited).size !== cited.length) {
+    fail("Model cited the same row more than once.");
+  }
+
+  if (answerable && cited.length === 0) {
+    fail("An answerable reply must cite at least one finding.");
+  }
+  if (!answerable && cited.length > 0) {
+    fail("A reply marked unanswerable must not cite findings.");
+  }
+
+  // The number guard. No threshold: any figure the engine did not produce fails.
+  const allowed = allowedNumbers(result);
+  for (const value of extractNumbers(answer)) {
+    if (!allowed.has(value)) {
+      fail(`Model stated a number that the engine did not produce: ${value}.`);
+    }
+  }
+
+  return {
+    answer: answer.trim(),
+    citedRowIds: cited,
+    answerable,
+  };
+}
+
+/**
+ * The response shape demanded from the model. Kept next to the validator so the
+ * schema and the checks cannot drift apart.
+ */
+export function createAnswerJsonSchema(): Record<string, unknown> {
+  return {
+    type: "object",
+    additionalProperties: false,
+    required: ["answer", "citedRowIds", "answerable"],
+    properties: {
+      answerable: {
+        type: "boolean",
+        description:
+          "True only if the question can be answered from the supplied findings.",
+      },
+      answer: {
+        type: "string",
+        description:
+          "Short reply in the requested language. Plain words. No tax advice.",
+      },
+      citedRowIds: {
+        type: "array",
+        items: { type: "string" },
+        description: "Row IDs this answer relies on. Empty if not answerable.",
+      },
+    },
+  };
+}
+
+/**
+ * The only thing the model sees. Deliberately excludes anything that would let
+ * it compute: no raw tax rows, no purchase register, no arithmetic inputs.
+ */
+export function buildAnswerModelInput(
+  result: RiskAssessmentResult,
+  question: string,
+  language: "hi" | "en",
+): Record<string, unknown> {
+  return {
+    question,
+    replyLanguage: language,
+    deadline: result.actionDeadline,
+    daysRemaining: result.daysRemaining,
+    totalAmountAtRisk: result.totalAmountAtRisk,
+    amountLostIfNothingDone: result.amountLostIfNothingDone,
+    findings: result.items.map((item) => ({
+      rowId: item.rowId,
+      supplierName: item.supplierName,
+      category: item.category,
+      severity: item.severity,
+      amountAtRisk: item.amountAtRisk,
+      whyItMatters: item.whyItMatters,
+      whoCausedIt: item.whoCausedIt,
+      whatToDo: item.whatToDo,
+    })),
+  };
+}
diff --git a/prototype/tests/answer-validator.test.ts b/prototype/tests/answer-validator.test.ts
new file mode 100644
index 0000000..cf8fea6
--- /dev/null
+++ b/prototype/tests/answer-validator.test.ts
@@ -0,0 +1,186 @@
+import { describe, expect, it } from "vitest";
+
+import { riskCase } from "../src/data/riskCase";
+import { assessRisk } from "../src/domain/assessRisk";
+import {
+  allowedMoneyFigures,
+  assertQuestionAcceptable,
+  buildAnswerModelInput,
+  extractNumbers,
+  validateModelAnswer,
+} from "../src/services/answerValidator";
+
+const result = assessRisk(riskCase, "2026-09-15");
+
+const goodAnswer = {
+  answerable: true,
+  answer:
+    "Aapke supplier Verma Packaging ne ek note bheja hai jo aapka credit 86400 rupaye kam karta hai. Abhi tak koi jawab nahi diya gaya.",
+  citedRowIds: ["DEMO-ROW-0003"],
+};
+
+describe("question guard", () => {
+  it("accepts an ordinary question", () => {
+    expect(assertQuestionAcceptable("mera paisa kyun kam hua?")).toBe(
+      "mera paisa kyun kam hua?",
+    );
+  });
+
+  it("accepts a Hindi question", () => {
+    expect(assertQuestionAcceptable("मेरा पैसा क्यों कम हुआ?")).toContain("पैसा");
+  });
+
+  it("rejects an empty question", () => {
+    expect(() => assertQuestionAcceptable("   ")).toThrow(/must not be empty/);
+  });
+
+  it("rejects an oversized question", () => {
+    expect(() => assertQuestionAcceptable("a".repeat(301))).toThrow(
+      /300 characters/,
+    );
+  });
+});
+
+describe("number extraction", () => {
+  it("reads Indian digit grouping", () => {
+    expect(extractNumbers("Rs 1,52,000 is at risk")).toContain(152_000);
+  });
+
+  it("reads Devanagari digits", () => {
+    expect(extractNumbers("८६४०० रुपये")).toContain(86_400);
+  });
+
+  it("returns nothing when there are no digits", () => {
+    expect(extractNumbers("koi number nahi hai")).toEqual([]);
+  });
+});
+
+describe("allowed money figures", () => {
+  it("includes every at-risk amount and both totals", () => {
+    const allowed = allowedMoneyFigures(result);
+    expect(allowed.has(86_400)).toBe(true);
+    expect(allowed.has(152_000)).toBe(true);
+    expect(allowed.has(324_400)).toBe(true);
+    // 38,500 is the harmless deemed-accept row, never at risk, so never quotable.
+    expect(allowed.has(38_500)).toBe(false);
+  });
+});
+
+describe("validateModelAnswer", () => {
+  it("accepts a grounded answer that cites a real finding", () => {
+    const validated = validateModelAnswer(goodAnswer, result);
+    expect(validated.citedRowIds).toEqual(["DEMO-ROW-0003"]);
+    expect(validated.answerable).toBe(true);
+  });
+
+  it("BLOCKS an invented rupee figure", () => {
+    const hallucinated = {
+      ...goodAnswer,
+      answer: "Aapka nuksan 99999 rupaye ka hai.",
+    };
+    expect(() => validateModelAnswer(hallucinated, result)).toThrow(
+      /number that the engine did not produce/,
+    );
+  });
+
+  it("BLOCKS a figure that exists but is not at risk", () => {
+    const wrong = {
+      ...goodAnswer,
+      answer: "Aap 38500 rupaye kho rahe hain.",
+    };
+    expect(() => validateModelAnswer(wrong, result)).toThrow(
+      /did not produce: 38500/,
+    );
+  });
+
+  it("BLOCKS a small invented figure, with no lower threshold", () => {
+    // Regression guard. An earlier version only checked figures >= 1000, so a
+    // wrong "800 rupaye" slipped through. There is no safe threshold.
+    const wrong = { ...goodAnswer, answer: "Sirf 800 rupaye ka farak hai." };
+    expect(() => validateModelAnswer(wrong, result)).toThrow(
+      /did not produce: 800/,
+    );
+  });
+
+  it("BLOCKS an invented percentage or small count", () => {
+    const wrong = { ...goodAnswer, answer: "Aapke 15 bill kharab hain." };
+    expect(() => validateModelAnswer(wrong, result)).toThrow(
+      /did not produce: 15/,
+    );
+  });
+
+  it("blocks a citation to a row that does not exist", () => {
+    const wrong = { ...goodAnswer, citedRowIds: ["DEMO-ROW-9999"] };
+    expect(() => validateModelAnswer(wrong, result)).toThrow(/unknown row/);
+  });
+
+  it("blocks an answerable reply that cites nothing", () => {
+    const wrong = { ...goodAnswer, citedRowIds: [] };
+    expect(() => validateModelAnswer(wrong, result)).toThrow(
+      /must cite at least one finding/,
+    );
+  });
+
+  it("allows a refusal that cites nothing", () => {
+    const refusal = {
+      answerable: false,
+      answer:
+        "Yeh sawaal is jaankari se nahi bataya ja sakta. Kisi GST professional se poochhiye.",
+      citedRowIds: [],
+    };
+    expect(validateModelAnswer(refusal, result).answerable).toBe(false);
+  });
+
+  it("blocks a refusal that still cites findings", () => {
+    const wrong = {
+      answerable: false,
+      answer: "Pata nahi.",
+      citedRowIds: ["DEMO-ROW-0003"],
+    };
+    expect(() => validateModelAnswer(wrong, result)).toThrow(
+      /must not cite findings/,
+    );
+  });
+
+  it("blocks a duplicate citation", () => {
+    const wrong = {
+      ...goodAnswer,
+      citedRowIds: ["DEMO-ROW-0003", "DEMO-ROW-0003"],
+    };
+    expect(() => validateModelAnswer(wrong, result)).toThrow(/more than once/);
+  });
+
+  it("rejects a malformed payload", () => {
+    expect(() => validateModelAnswer("not an object", result)).toThrow(
+      /must be an object/,
+    );
+    expect(() => validateModelAnswer({ answer: "hi" }, result)).toThrow(
+      /answerable/,
+    );
+  });
+
+  it("allows dates and day counts the engine actually holds", () => {
+    const withDates = {
+      ...goodAnswer,
+      answer: "20 October tak jawab dijiye. Sirf 35 din bache hain.",
+    };
+    expect(validateModelAnswer(withDates, result).answerable).toBe(true);
+  });
+
+  it("allows a legitimate count of findings", () => {
+    const withCount = { ...goodAnswer, answer: "4 bill par dhyan dijiye." };
+    expect(validateModelAnswer(withCount, result).answerable).toBe(true);
+  });
+});
+
+describe("model input", () => {
+  it("sends findings but never the raw tax rows", () => {
+    const input = buildAnswerModelInput(result, "kya hua?", "hi");
+    expect(input.replyLanguage).toBe("hi");
+    expect(Array.isArray(input.findings)).toBe(true);
+    const serialized = JSON.stringify(input);
+    // The purchase register and 2B rows must never reach the model.
+    expect(serialized).not.toContain("supplierGstin");
+    expect(serialized).not.toContain("inPurchaseRegister");
+  });
+});
diff --git a/prototype/tests/assess-risk.test.ts b/prototype/tests/assess-risk.test.ts
new file mode 100644
index 0000000..0bb5276
--- /dev/null
+++ b/prototype/tests/assess-risk.test.ts
@@ -0,0 +1,155 @@
+import { describe, expect, it } from "vitest";
+
+import type { RiskCase, RiskCategory } from "../src/contracts/riskAssessment";
+import { riskCase } from "../src/data/riskCase";
+import {
+  assessRisk,
+  classifyRiskRow,
+  sortItemsForDisplay,
+} from "../src/domain/assessRisk";
+
+/**
+ * Ground truth from `fixtures/answer-key.json`, produced by the generator.
+ * Two rows are deliberately NOT at risk: an engine that flags everything fails
+ * this key, which is the point.
+ */
+const ANSWER_KEY: ReadonlyArray<{
+  rowId: string;
+  expectedCategory: RiskCategory;
+  expectedAmountAtRisk: number;
+}> = [
+  { rowId: "DEMO-ROW-0001", expectedCategory: "no_action_needed", expectedAmountAtRisk: 0 },
+  { rowId: "DEMO-ROW-0002", expectedCategory: "no_action_needed", expectedAmountAtRisk: 0 },
+  { rowId: "DEMO-ROW-0003", expectedCategory: "credit_note_reducing_itc", expectedAmountAtRisk: 86_400 },
+  { rowId: "DEMO-ROW-0004", expectedCategory: "supplier_not_filed", expectedAmountAtRisk: 152_000 },
+  { rowId: "DEMO-ROW-0005", expectedCategory: "deemed_accept_harmless", expectedAmountAtRisk: 0 },
+  { rowId: "DEMO-ROW-0006", expectedCategory: "itc_not_available", expectedAmountAtRisk: 22_000 },
+  { rowId: "DEMO-ROW-0007", expectedCategory: "wrongly_rejected", expectedAmountAtRisk: 64_000 },
+];
+
+const EXPECTED_TOTAL_AT_RISK = 324_400;
+const EXPECTED_SILENT_LOSS = 86_400;
+
+describe("assessRisk scored against the answer key", () => {
+  const result = assessRisk(riskCase, "2026-09-15");
+
+  it("classifies every row exactly as the answer key expects", () => {
+    for (const expected of ANSWER_KEY) {
+      const item = result.items.find((candidate) => candidate.rowId === expected.rowId);
+      expect(item, `missing row ${expected.rowId}`).toBeDefined();
+      expect(item!.category).toBe(expected.expectedCategory);
+      expect(item!.amountAtRisk).toBe(expected.expectedAmountAtRisk);
+    }
+  });
+
+  it("produces one item per source row and no extras", () => {
+    expect(result.items).toHaveLength(riskCase.rows.length);
+    expect(new Set(result.items.map((item) => item.rowId)).size).toBe(
+      riskCase.rows.length,
+    );
+  });
+
+  it("totals the amount at risk exactly", () => {
+    expect(result.totalAmountAtRisk).toBe(EXPECTED_TOTAL_AT_RISK);
+  });
+
+  it("isolates the amount lost with no further human involvement", () => {
+    expect(result.amountLostIfNothingDone).toBe(EXPECTED_SILENT_LOSS);
+  });
+
+  it("does not flag rows that need no action", () => {
+    const harmless = result.items.filter(
+      (item) => item.severity === "ok" || item.severity === "info",
+    );
+    expect(harmless).toHaveLength(3);
+    for (const item of harmless) {
+      expect(item.amountAtRisk).toBe(0);
+    }
+  });
+
+  it("counts the days remaining to the action deadline", () => {
+    expect(result.daysRemaining).toBe(35);
+  });
+
+  it("attributes each at-risk item to a responsible party", () => {
+    const creditNote = result.items.find((item) => item.rowId === "DEMO-ROW-0003");
+    expect(creditNote!.whoCausedIt).toBe("supplier");
+    const rejected = result.items.find((item) => item.rowId === "DEMO-ROW-0007");
+    expect(rejected!.whoCausedIt).toBe("you");
+  });
+
+  it("carries the evidence fields that produced each verdict", () => {
+    const notFiled = result.items.find((item) => item.rowId === "DEMO-ROW-0004");
+    expect(notFiled!.evidenceFields.supplierFiledDate).toBeNull();
+    expect(notFiled!.evidenceFields.inPurchaseRegister).toBe(true);
+  });
+
+  it("surfaces the reason when the statement blocks the credit", () => {
+    const blocked = result.items.find((item) => item.rowId === "DEMO-ROW-0006");
+    expect(blocked!.evidenceFields.unavailableReason).toContain("POS");
+  });
+});
+
+describe("display ordering", () => {
+  it("puts the items that expire first at the top, largest first", () => {
+    const result = assessRisk(riskCase, "2026-09-15");
+    const sorted = sortItemsForDisplay(result.items);
+    expect(sorted[0].severity).toBe("act_now");
+    expect(sorted[0].amountAtRisk).toBe(152_000);
+    expect(sorted[sorted.length - 1].severity).toBe("ok");
+  });
+});
+
+describe("classification rules in isolation", () => {
+  const base = riskCase.rows[0];
+
+  it("treats an unactioned credit note as a silent loss", () => {
+    expect(
+      classifyRiskRow({ ...base, docType: "credit_note", imsStatus: "N" }),
+    ).toBe("credit_note_reducing_itc");
+  });
+
+  it("treats an accepted credit note as already decided", () => {
+    expect(
+      classifyRiskRow({ ...base, docType: "credit_note", imsStatus: "A" }),
+    ).toBe("no_action_needed");
+  });
+
+  it("does not call an unactioned invoice a loss when the books agree", () => {
+    expect(classifyRiskRow({ ...base, imsStatus: "N" })).toBe(
+      "deemed_accept_harmless",
+    );
+  });
+
+  it("ignores a rejection for something we never bought", () => {
+    expect(
+      classifyRiskRow({ ...base, imsStatus: "R", inPurchaseRegister: false }),
+    ).toBe("no_action_needed");
+  });
+});
+
+describe("input validation", () => {
+  it("rejects a case whose identifiers are not synthetic", () => {
+    const bad = {
+      ...riskCase,
+      id: "REAL-CASE-01",
+    } as unknown as RiskCase;
+    expect(() => assessRisk(bad)).toThrow(/must begin with DEMO-/);
+  });
+
+  it("rejects a deadline that falls before the statement date", () => {
+    const bad: RiskCase = {
+      ...riskCase,
+      actionDeadline: "2026-09-01",
+    };
+    expect(() => assessRisk(bad)).toThrow(/must not be before/);
+  });
+
+  it("rejects a row that has a status but never reached the statement", () => {
+    const bad: RiskCase = {
+      ...riskCase,
+      rows: [{ ...riskCase.rows[0], supplierFiledDate: null, imsStatus: "A" }],
+    };
+    expect(() => assessRisk(bad)).toThrow(/imsStatus must be null/);
+  });
+});
